# ============================================
# White-Label WhatsApp Chatbot - Exemplo
# Copie para .env e preencha com seus dados
# cp .env.example .env
# ============================================

# --- Aplicação / White Label ---
APP_NAME=WhatsApp Chatbot
APP_VERSION=1.1.0
BUSINESS_NAME=Sua Empresa
BUSINESS_DESCRIPTION=Atendimento automatizado via WhatsApp
BUSINESS_FOOTER=Seus dados serão usados apenas para atendimento, conforme LGPD.
HUMAN_ATTENDANT_NAME=Equipe de Atendimento
# Mensagem de boas-vindas (opcional - se vazio usa padrão dos menus)
WELCOME_TITLE=Bem-vindo(a)!
WELCOME_BODY=Olá! Seja bem-vindo(a). Escolha uma das opções abaixo para continuar.

# --- Provider WhatsApp ---
# Opções: meta | baileys
WHATSAPP_PROVIDER=baileys

# --- Meta Cloud API (usado se WHATSAPP_PROVIDER=meta) ---
# Obtenha em developers.facebook.com > Seu App > WhatsApp > API Setup
# PHONE_NUMBER_ID: ID do número (ex: 123456789012345)
# WHATSAPP_TOKEN: token de acesso de longa duração (System User)
# VERIFY_TOKEN: string que você define para verificação do webhook
META_API_VERSION=v25.0
PHONE_NUMBER_ID=
WHATSAPP_TOKEN=
VERIFY_TOKEN=seu_verify_token_seguro

# --- Baileys Connector (usado se WHATSAPP_PROVIDER=baileys) ---
CONNECTOR_URL=http://localhost:3300
CONNECTOR_SECRET=troque-este-secret

# --- Sessão / Banco ---
SESSIONS_DB_PATH=data/sessions.db
SESSION_TIMEOUT_SECONDS=1800

# --- Servidor ---
PORT=8000
LOG_LEVEL=info
